LAMMPS (22 Jul 2025 - Update 3)
  using 10 OpenMP thread(s) per MPI task
# ------------------------------------------------------------------
# 1. INITIALIZATION
# ------------------------------------------------------------------
units           metal          # eV and Angstroms (Matches Deng/Du paper)
atom_style      charge
boundary        p p p
read_data       SlabV2.data
Reading data file ...
  orthogonal box = (0 0 0) to (18.779726 18.779726 22.535672)
  2 by 2 by 5 MPI processor grid
  reading atom labelmap ...
  reading atoms ...
  589 atoms
  read_data CPU = 0.007 seconds

# ------------------------------------------------------------------
# 2. ASSIGN CHARGES (From Deng & Du 2016)
# ------------------------------------------------------------------
# 1=Si, 2=O, 3=B, 4=Na, 5=Al

set type 1 charge  1.890   # Si
Setting atom values ...
  5 settings made for charge
set type 2 charge -0.945   # O
Setting atom values ...
  17 settings made for charge
set type 3 charge  1.418   # B
Setting atom values ...
  142 settings made for charge
set type 4 charge  0.473   # Na
Setting atom values ...
  375 settings made for charge
set type 5 charge  1.418   # Al
Setting atom values ...
  50 settings made for charge
mass 1 28.086
mass 2 15.999
mass 3 10.811
mass 4 22.990
mass 5 26.982

# ------------------------------------------------------------------
# 3. FIX DENSITY & OVERLAPS (The Soft Ramp Method)
# ------------------------------------------------------------------

# A. DEFINE SOFT POTENTIAL
# Start with a "Soft" potential with cutoff 2.5 Angstroms
pair_style      soft 2.5
pair_coeff      * * 0.0 2.5   # Start with Energy A = 0.0 (Ghost atoms)

# B. RAMP REPULSION
# We ramp the pre-factor 'A' from 0.0 to 100.0 eV.
# This slowly "inflates" the atoms, pushing overlapping ones apart gently.
variable        prefactor equal ramp(0.0,100.0)
fix             1 all adapt 1 pair soft a * * v_prefactor

# C. INITIALIZE VELOCITIES
velocity        all create 300.0 12345 dist gaussian
timestep        0.001
thermo          100

print "--- STARTING SOFT RAMP ---"
--- STARTING SOFT RAMP ---

# D. Run with NVE to let them push apart
fix             2 all nve
run             10000

